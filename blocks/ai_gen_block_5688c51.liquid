{% doc %}
  @prompt
    make imge banner 2 size first desktop and tablet
    second
    mobile, mobile  just show in mobile version 
    i need banner imge or video
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-responsive-banner__container-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-responsive-banner__desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-responsive-banner__mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
  }

  .ai-responsive-banner__media-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-responsive-banner__video-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-responsive-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: {{ block.settings.desktop_min_height }}px;
  }

  .ai-responsive-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-responsive-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-responsive-banner__desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-responsive-banner__mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-responsive-banner__placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
    }
  }
{% endstyle %}

<responsive-banner-{{ ai_gen_id }} class="ai-responsive-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-responsive-banner__container-{{ ai_gen_id }}">
    <div class="ai-responsive-banner__desktop-{{ ai_gen_id }}">
      {% if block.settings.desktop_media_type == 'image' %}
        {% if block.settings.desktop_image %}
          <img
            src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
            alt="{{ block.settings.desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.desktop_image.width }}"
            height="{{ block.settings.desktop_image.height }}"
            class="ai-responsive-banner__media-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-responsive-banner__placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-responsive-banner__empty-state-{{ ai_gen_id }}">
              Add a desktop image
            </div>
          </div>
        {% endif %}
      {% elsif block.settings.desktop_media_type == 'video' %}
        {% if block.settings.desktop_video %}
          <video
            class="ai-responsive-banner__video-{{ ai_gen_id }}"
            {% if block.settings.desktop_video_autoplay %}autoplay{% endif %}
            {% if block.settings.desktop_video_loop %}loop{% endif %}
            {% if block.settings.desktop_video_muted %}muted{% endif %}
            playsinline
          >
            <source src="{{ block.settings.desktop_video }}" type="video/mp4">
          </video>
        {% else %}
          <div class="ai-responsive-banner__placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-responsive-banner__empty-state-{{ ai_gen_id }}">
              Add a desktop video URL
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>

    <div class="ai-responsive-banner__mobile-{{ ai_gen_id }}">
      {% if block.settings.mobile_media_type == 'image' %}
        {% if block.settings.mobile_image %}
          <img
            src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
            alt="{{ block.settings.mobile_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.mobile_image.width }}"
            height="{{ block.settings.mobile_image.height }}"
            class="ai-responsive-banner__media-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-responsive-banner__placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-responsive-banner__empty-state-{{ ai_gen_id }}">
              Add a mobile image
            </div>
          </div>
        {% endif %}
      {% elsif block.settings.mobile_media_type == 'video' %}
        {% if block.settings.mobile_video %}
          <video
            class="ai-responsive-banner__video-{{ ai_gen_id }}"
            {% if block.settings.mobile_video_autoplay %}autoplay{% endif %}
            {% if block.settings.mobile_video_loop %}loop{% endif %}
            {% if block.settings.mobile_video_muted %}muted{% endif %}
            playsinline
          >
            <source src="{{ block.settings.mobile_video }}" type="video/mp4">
          </video>
        {% else %}
          <div class="ai-responsive-banner__placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-responsive-banner__empty-state-{{ ai_gen_id }}">
              Add a mobile video URL
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</responsive-banner-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Responsive banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Desktop and tablet"
    },
    {
      "type": "select",
      "id": "desktop_media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "desktop_video",
      "label": "Video URL"
    },
    {
      "type": "checkbox",
      "id": "desktop_video_autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_video_loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_video_muted",
      "label": "Mute video",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_min_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 400
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "mobile_video",
      "label": "Video URL"
    },
    {
      "type": "checkbox",
      "id": "mobile_video_autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_video_loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_video_muted",
      "label": "Mute video",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Responsive banner"
    }
  ]
}
{% endschema %}
