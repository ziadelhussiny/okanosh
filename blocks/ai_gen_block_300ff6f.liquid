{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-premium-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-premium-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-premium-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .ai-premium-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-premium-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    margin: 0 -20px;
    padding: 0 20px;
  }

  .ai-premium-carousel__track-container-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-premium-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    cursor: grab;
    user-select: none;
  }

  .ai-premium-carousel__track-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  .ai-premium-carousel__track-{{ ai_gen_id }}.is-auto-scrolling {
    transition: transform {{ block.settings.mobile_scroll_duration }}s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-premium-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.grid_gap }}px)) / {{ block.settings.columns_desktop }});
    background-color: {{ block.settings.card_background }};
    position: relative;
  }

  .ai-premium-carousel__link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
  }

  .ai-premium-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background-color: #ffffff;
  }

  .ai-premium-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-premium-carousel__item-{{ ai_gen_id }}:hover .ai-premium-carousel__image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.hover_image_scale | divided_by: 100.0 }});
  }

  .ai-premium-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-premium-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-premium-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .ai-premium-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.overlay_background }};
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.overlay_position }};
    align-items: center;
    padding: {{ block.settings.overlay_padding }}px;
    pointer-events: none;
  }

  .ai-premium-carousel__item-{{ ai_gen_id }}:hover .ai-premium-carousel__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-premium-carousel__overlay-content-{{ ai_gen_id }} {
    text-align: center;
    transform: translateY(10px);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-premium-carousel__item-{{ ai_gen_id }}:hover .ai-premium-carousel__overlay-content-{{ ai_gen_id }} {
    transform: translateY(0);
  }

  .ai-premium-carousel__overlay-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.overlay_title_size }}px;
    color: {{ block.settings.overlay_text_color }};
    margin: 0 0 8px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .ai-premium-carousel__overlay-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.overlay_category_size }}px;
    color: {{ block.settings.overlay_text_color }};
    margin: 0 0 6px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.9;
  }

  .ai-premium-carousel__overlay-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.overlay_price_size }}px;
    color: {{ block.settings.overlay_text_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-premium-carousel__static-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-premium-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .ai-premium-carousel__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    margin: 0;
    font-weight: 400;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_tablet | minus: 1 }} * {{ block.settings.grid_gap }}px)) / {{ block.settings.columns_tablet }});
    }

    .ai-premium-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-premium-carousel__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-premium-carousel__overlay-{{ ai_gen_id }} {
      opacity: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.grid_gap | times: 0.75 }}px)) / {{ block.settings.columns_mobile }});
    }

    .ai-premium-carousel__track-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-premium-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-premium-carousel__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.8);
    }

    .ai-premium-carousel__product-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.product_title_size }}px * 0.9);
    }

    .ai-premium-carousel__product-price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.product_price_size }}px * 0.9);
    }

    .ai-premium-carousel-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-premium-carousel__overlay-{{ ai_gen_id }} {
      opacity: 0;
    }

    .ai-premium-carousel__item-{{ ai_gen_id }}:hover .ai-premium-carousel__image-{{ ai_gen_id }} {
      transform: none;
    }
  }
{% endstyle %}

<premium-carousel-{{ ai_gen_id }} class="ai-premium-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-premium-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-premium-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-premium-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-premium-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-premium-carousel__track-container-{{ ai_gen_id }}" tabindex="0" role="region" aria-label="Product carousel">
        <div class="ai-premium-carousel__track-{{ ai_gen_id }}" data-track role="list">
          {% liquid
            assign collection = block.settings.collection
            assign products_to_show = collection.products
            
            if collection == blank
              assign products_to_show = blank
            endif
          %}

          {% if products_to_show != blank %}
            {% for product in products_to_show limit: block.settings.products_limit %}
              <div class="ai-premium-carousel__item-{{ ai_gen_id }}" role="listitem">
                <a href="{{ product.url }}" class="ai-premium-carousel__link-{{ ai_gen_id }}">
                  <div class="ai-premium-carousel__image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 800 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        loading="lazy"
                        width="800"
                        height="{{ 800 | divided_by: block.settings.image_ratio }}"
                        class="ai-premium-carousel__image-{{ ai_gen_id }}"
                      >
                    {% else %}
                      <div class="ai-premium-carousel__placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}

                    {% if block.settings.show_overlay %}
                      <div class="ai-premium-carousel__overlay-{{ ai_gen_id }}">
                        <div class="ai-premium-carousel__overlay-content-{{ ai_gen_id }}">
                          {% if block.settings.show_overlay_category and product.type != blank %}
                            <div class="ai-premium-carousel__overlay-category-{{ ai_gen_id }}">{{ product.type }}</div>
                          {% endif %}
                          <h3 class="ai-premium-carousel__overlay-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                          {% if block.settings.show_overlay_price %}
                            <div class="ai-premium-carousel__overlay-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  </div>

                  {% if block.settings.show_static_info %}
                    <div class="ai-premium-carousel__static-content-{{ ai_gen_id }}">
                      <h3 class="ai-premium-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                      <div class="ai-premium-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                    </div>
                  {% endif %}
                </a>
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..8) %}
              <div class="ai-premium-carousel__item-{{ ai_gen_id }}" role="listitem">
                <div class="ai-premium-carousel__image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-premium-carousel__placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                    <div class="ai-premium-carousel__empty-state-{{ ai_gen_id }}">
                      Next, select a collection
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</premium-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.container = this.querySelector('[tabindex="0"]');
        this.isDragging = false;
        this.startPos = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.animationID = 0;
        this.currentIndex = 0;
        this.velocity = 0;
        this.lastPos = 0;
        this.lastTime = Date.now();
        this.autoScrollTimeout = null;
        this.holdTimeout = null;
        this.resumeTimeout = null;
        this.isAutoScrolling = false;
        this.userInteracting = false;
      }

      connectedCallback() {
        this.setupDragAndSwipe();
        this.setupKeyboardNav();
        this.startAutoScroll();
        window.addEventListener('resize', () => this.handleResize());
      }

      disconnectedCallback() {
        this.stopAutoScroll();
      }

      isMobile() {
        return window.innerWidth <= 749;
      }

      getItemsPerView() {
        const width = window.innerWidth;
        if (width <= 749) return {{ block.settings.columns_mobile }};
        if (width <= 989) return {{ block.settings.columns_tablet }};
        return {{ block.settings.columns_desktop }};
      }

      getItemWidth() {
        return this.track.children[0]?.offsetWidth || 0;
      }

      getGap() {
        const width = window.innerWidth;
        if (width <= 749) return {{ block.settings.grid_gap }} * 0.75;
        return {{ block.settings.grid_gap }};
      }

      getMaxIndex() {
        const items = this.track.children.length;
        const itemsPerView = this.getItemsPerView();
        return Math.max(0, items - itemsPerView);
      }

      handleResize() {
        this.stopAutoScroll();
        this.updatePosition();
        this.startAutoScroll();
      }

      updatePosition() {
        const itemWidth = this.getItemWidth();
        const gap = this.getGap();
        const offset = -(this.currentIndex * (itemWidth + gap));
        this.currentTranslate = offset;
        this.prevTranslate = offset;
        this.track.style.transform = `translateX(${offset}px)`;
      }

      startAutoScroll() {
        if (!this.isMobile() || !{{ block.settings.enable_mobile_auto_scroll }}) return;
        
        this.scheduleNextScroll();
      }

      scheduleNextScroll() {
        if (this.holdTimeout) clearTimeout(this.holdTimeout);
        
        this.holdTimeout = setTimeout(() => {
          if (!this.userInteracting) {
            this.moveToNext();
          }
        }, {{ block.settings.mobile_hold_duration }} * 1000);
      }

      moveToNext() {
        const maxIndex = this.getMaxIndex();
        
        this.currentIndex++;
        if (this.currentIndex > maxIndex) {
          this.currentIndex = 0;
        }
        
        const itemWidth = this.getItemWidth();
        const gap = this.getGap();
        const offset = -(this.currentIndex * (itemWidth + gap));
        
        this.currentTranslate = offset;
        this.prevTranslate = offset;
        
        this.isAutoScrolling = true;
        this.track.classList.add('is-auto-scrolling');
        this.track.style.transform = `translateX(${offset}px)`;
        
        setTimeout(() => {
          this.track.classList.remove('is-auto-scrolling');
          this.isAutoScrolling = false;
          this.scheduleNextScroll();
        }, {{ block.settings.mobile_scroll_duration }} * 1000);
      }

      stopAutoScroll() {
        if (this.holdTimeout) {
          clearTimeout(this.holdTimeout);
          this.holdTimeout = null;
        }
        if (this.resumeTimeout) {
          clearTimeout(this.resumeTimeout);
          this.resumeTimeout = null;
        }
        this.track.classList.remove('is-auto-scrolling');
        this.isAutoScrolling = false;
      }

      pauseAndResume() {
        this.userInteracting = true;
        this.stopAutoScroll();
        
        if (this.resumeTimeout) clearTimeout(this.resumeTimeout);
        
        this.resumeTimeout = setTimeout(() => {
          this.userInteracting = false;
          if (this.isMobile() && {{ block.settings.enable_mobile_auto_scroll }}) {
            this.scheduleNextScroll();
          }
        }, {{ block.settings.mobile_resume_delay }} * 1000);
      }

      setupKeyboardNav() {
        this.container.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            this.moveToPrev();
            this.pauseAndResume();
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            this.moveToNextManual();
            this.pauseAndResume();
          }
        });
      }

      moveToPrev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.animateToIndex();
        }
      }

      moveToNextManual() {
        const maxIndex = this.getMaxIndex();
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.animateToIndex();
        }
      }

      animateToIndex() {
        const itemWidth = this.getItemWidth();
        const gap = this.getGap();
        const offset = -(this.currentIndex * (itemWidth + gap));
        
        this.currentTranslate = offset;
        this.prevTranslate = offset;
        
        this.track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        this.track.style.transform = `translateX(${offset}px)`;
        
        setTimeout(() => {
          this.track.style.transition = '';
        }, 600);
      }

      setupDragAndSwipe() {
        this.track.addEventListener('mousedown', (e) => this.dragStart(e));
        this.track.addEventListener('touchstart', (e) => this.dragStart(e), { passive: true });
        this.track.addEventListener('mouseup', (e) => this.dragEnd(e));
        this.track.addEventListener('touchend', (e) => this.dragEnd(e));
        this.track.addEventListener('mouseleave', (e) => this.dragEnd(e));
        this.track.addEventListener('mousemove', (e) => this.drag(e));
        this.track.addEventListener('touchmove', (e) => this.drag(e), { passive: true });
        
        this.track.querySelectorAll('a').forEach(link => {
          link.addEventListener('dragstart', (e) => e.preventDefault());
        });
      }

      getPositionX(event) {
        return event.type.includes('mouse') ? event.pageX : event.touches[0].clientX;
      }

      dragStart(event) {
        this.isDragging = true;
        this.startPos = this.getPositionX(event);
        this.lastPos = this.startPos;
        this.lastTime = Date.now();
        this.velocity = 0;
        this.track.classList.add('is-dragging');
        this.track.classList.remove('is-auto-scrolling');
        this.pauseAndResume();
        this.animationID = requestAnimationFrame(() => this.animation());
      }

      drag(event) {
        if (!this.isDragging) return;
        
        const currentPosition = this.getPositionX(event);
        const currentTime = Date.now();
        const timeDelta = currentTime - this.lastTime;
        
        if (timeDelta > 0) {
          this.velocity = (currentPosition - this.lastPos) / timeDelta;
        }
        
        this.lastPos = currentPosition;
        this.lastTime = currentTime;
        
        const diff = currentPosition - this.startPos;
        this.currentTranslate = this.prevTranslate + diff;
        
        const itemWidth = this.getItemWidth();
        const gap = this.getGap();
        const maxTranslate = -(this.getMaxIndex() * (itemWidth + gap));
        
        if (this.currentTranslate > 0) {
          this.currentTranslate = this.currentTranslate * 0.3;
        } else if (this.currentTranslate < maxTranslate) {
          this.currentTranslate = maxTranslate + (this.currentTranslate - maxTranslate) * 0.3;
        }
      }

      dragEnd(event) {
        if (!this.isDragging) return;
        
        this.isDragging = false;
        cancelAnimationFrame(this.animationID);
        this.track.classList.remove('is-dragging');

        const itemWidth = this.getItemWidth();
        const gap = this.getGap();
        const itemSize = itemWidth + gap;
        
        let targetTranslate = this.currentTranslate + this.velocity * 200;
        
        const maxTranslate = -(this.getMaxIndex() * itemSize);
        if (targetTranslate > 0) targetTranslate = 0;
        if (targetTranslate < maxTranslate) targetTranslate = maxTranslate;
        
        const targetIndex = Math.round(-targetTranslate / itemSize);
        this.currentIndex = targetIndex;
        
        const finalTranslate = -(targetIndex * itemSize);
        this.currentTranslate = finalTranslate;
        this.prevTranslate = finalTranslate;
        
        this.track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        this.track.style.transform = `translateX(${finalTranslate}px)`;
        
        setTimeout(() => {
          this.track.style.transition = '';
        }, 600);
      }

      animation() {
        if (this.isDragging) {
          this.track.style.transform = `translateX(${this.currentTranslate}px)`;
          requestAnimationFrame(() => this.animation());
        }
      }
    }

    customElements.define('premium-carousel-{{ ai_gen_id }}', PremiumCarousel{{ ai_gen_id }});
  })();
</script>

