<section class="zt-section zt-collections color-{{ section.settings.color_scheme }}" aria-labelledby="ZiadCollectionsHeading-{{ section.id }}">
  <div class="zt-section__inner">
    <div class="zt-collections__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="zt-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="zt-display" id="ZiadCollectionsHeading-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em class="zt-collections__accent">{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="zt-text-link" href="{{ routes.collections_url }}">{{ section.settings.link_label | escape }} →</a>{%- endif -%}
    </div>

    {%- if section.settings.enable_filter_shortcuts -%}
      {%- assign filter_collection = section.settings.filter_collection | default: collections.all -%}
      {%- capture filter_shortcuts -%}
        {%- for filter in filter_collection.filters -%}
          {%- liquid
            assign shortcut_title = ''
            assign filter_label = filter.label | downcase
            if filter_label == 'color' or filter_label == 'colour' or filter_label == 'اللون'
              assign shortcut_title = 'Shop by colour'
            elsif filter_label == 'fit' or filter_label == 'cut' or filter_label == 'القصّة'
              assign shortcut_title = 'Shop by cut'
            endif
          -%}
          {%- if shortcut_title != blank and filter.values.size > 0 -%}
            <details class="zt-filter-shortcut">
              <summary>{{ shortcut_title }}</summary>
              <ul role="list">
                {%- for value in filter.values -%}
                  {%- if value.count > 0 -%}
                    <li><a href="{{ value.url_to_add | escape }}">{{ value.label | escape }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if filter_shortcuts != blank -%}
        <div class="zt-filter-shortcuts">{{ filter_shortcuts }}</div>
      {%- endif -%}
    {%- endif -%}

    <div class="zt-collections__rail" style="--columns: {{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign collection_image = block.settings.image | default: collection.featured_image -%}
        <a class="zt-collection-card" href="{{ collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <div class="zt-collection-card__media">
            {%- if collection_image != blank -%}
              {{ collection_image | image_url: width: 1000 | image_tag: widths: '320, 480, 720, 1000', sizes: '(min-width: 990px) 20vw, 72vw', loading: 'lazy', alt: collection_image.alt | default: collection.title }}
            {%- else -%}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <span class="zt-collection-card__label">
            <span>{{ block.settings.title | default: collection.title | escape }}</span>
            {%- if collection != blank -%}
              <span class="zt-collection-card__count">{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}piece{% else %}pieces{% endif %}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ziad collections",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore Okanosh" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collections." },
    { "type": "text", "id": "heading_accent", "label": "Italic accent after heading" },
    { "type": "text", "id": "link_label", "label": "View all label", "default": "View all collections" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "enable_filter_shortcuts", "label": "Show colour and cut shortcuts", "default": true },
    { "type": "collection", "id": "filter_collection", "label": "Collection for filter shortcuts", "info": "Defaults to all products. Enable Color and Fit or Cut filters in Shopify Search & Discovery." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Custom title" }
      ]
    }
  ],
  "presets": [{ "name": "Ziad collections", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
