{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-info.js' | asset_url }}" defer></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer></script>
{%- endunless -%}

<ziad-product-view class="zt-section zt-product-edit color-{{ section.settings.color_scheme }}" aria-labelledby="ZiadProductEditHeading-{{ section.id }}">
  <div class="zt-section__inner">
    <div class="zt-product-edit__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="zt-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="zt-display" id="ZiadProductEditHeading-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em class="zt-product-edit__heading-accent">{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.enable_view_toggle -%}
        <div class="zt-product-edit__controls" aria-label="Product image view">
          <button class="zt-product-edit__toggle" type="button" data-ziad-product-view="model" aria-pressed="true">Styled on model</button>
          <button class="zt-product-edit__toggle" type="button" data-ziad-product-view="product" aria-pressed="false">Product view</button>
        </div>
      {%- endif -%}
      {%- if section.settings.collection != blank and section.settings.view_all_label != blank -%}
        <a class="zt-text-link" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label | escape }} →</a>
      {%- endif -%}
    </div>

    <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop zt-product-edit__grid" role="list" data-ziad-product-grid>
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li class="grid__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'portrait',
              image_shape: 'default',
              lazy_load: true,
              show_secondary_image: true,
              show_vendor: false,
              show_rating: false,
              quick_add: section.settings.quick_add,
              section_id: section.id
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..4) -%}
          <li class="grid__item">
            {% render 'card-product', media_aspect_ratio: 'portrait', placeholder_image: 'product-apparel-1' %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

  </div>
</ziad-product-view>

{% schema %}
{
  "name": "Ziad product edit",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New and noteworthy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The FW27 edit." },
    { "type": "text", "id": "heading_accent", "label": "Italic accent after heading" },
    { "type": "collection", "id": "collection", "label": "Products collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "enable_view_toggle", "label": "Enable model / product view", "default": true },
    { "type": "select", "id": "quick_add", "label": "Quick add", "default": "standard", "options": [{ "value": "none", "label": "None" }, { "value": "standard", "label": "Standard" }, { "value": "bulk", "label": "Bulk" }] },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View the full edit" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Ziad product edit" }]
}
{% endschema %}
