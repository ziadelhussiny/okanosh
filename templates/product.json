{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": { "type": "text", "settings": { "text": "{{ product.vendor }}", "text_style": "uppercase" } },
        "title": { "type": "title", "settings": {} },
        "price": { "type": "price", "settings": {} },
        "wishlist": { "type": "wishlist", "settings": {} },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "button", "swatch_shape": "circle" } },
        "size_chart": { "type": "size_chart", "settings": { "heading": "Size chart", "label": "View size chart", "page": "" } },
        "assurance": { "type": "purchase_assurance", "settings": { "delivery_heading": "Complimentary delivery", "delivery_text": "On orders over 3,000 L.E.", "exchange_heading": "Easy exchange", "exchange_text": "Contact us within 24 hours", "payment_heading": "Secure payment", "payment_text": "Protected checkout" } },
        "quantity_selector": { "type": "quantity_selector", "settings": {} },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true, "show_gift_card_recipient": true } },
        "description": { "type": "description", "settings": {} },
        "returns": { "type": "collapsible_tab", "settings": { "heading": "Exchange and Refund Policy", "icon": "none", "content": "<h2>Refund & Exchange Policy</h2><h3>Immediate Inspection Upon Delivery</h3><ul><li>We kindly ask you to try on the items you purchased while the courier is still there. You may return them immediately if you want.<br>Please note that you can either choose to keep the whole order or return the whole order.<br>Items cannot be returned once the courier leaves.<br>If you want to exchange, send us a message within 24 hours.<br>Items must be returned in their original packaging with all the tags attached.<br>An additional shipping fee will be charged for exchanges.</li></ul>", "page": "" } },
        "care": { "type": "collapsible_tab", "settings": { "heading": "Product care", "icon": "none", "content": "<h4>Dry clean recommended for all our products.<br>Do not tumble dry.<br>Do not bleach.<br>Avoid machine washing.<br>Wash inside out.<br>Iron on low heat (max 40°C).</h4>", "page": "" } },
        "share": { "type": "share", "settings": { "share_label": "Share" } }
      },
      "block_order": ["vendor", "title", "price", "wishlist", "variant_picker", "size_chart", "assurance", "quantity_selector", "buy_buttons", "description", "returns", "care", "share"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "recently-viewed": {
      "type": "ziad-recently-viewed",
      "settings": {
        "eyebrow": "Your edit",
        "heading": "Recently viewed.",
        "products_to_show": 4,
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": ["main", "related-products", "recently-viewed"]
}
