<ziad-wishlist-drawer>
  <dialog class="zt-wishlist-drawer" id="ZiadWishlistDrawer" aria-labelledby="ZiadWishlistHeading">
    <div class="zt-wishlist-drawer__header">
      <div>
        <p class="zt-eyebrow">Saved for later</p>
        <h2 id="ZiadWishlistHeading">Your wishlist <span data-ziad-wishlist-drawer-count></span></h2>
      </div>
      <button type="button" class="zt-wishlist-drawer__close" data-ziad-wishlist-close aria-label="Close wishlist">×</button>
    </div>
    <div class="zt-wishlist-drawer__body">
      <div class="zt-wishlist-drawer__items" data-ziad-wishlist-items></div>
      <div class="zt-wishlist-drawer__empty" data-ziad-wishlist-empty>
        <p class="zt-wishlist-drawer__empty-title">Nothing saved yet.</p>
        <p>Use the heart on any piece to keep it here while you browse.</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">Explore all pieces</a>
      </div>
    </div>
  </dialog>
</ziad-wishlist-drawer>
