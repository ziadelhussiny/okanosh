{%- assign new_arrivals = collections['new-arrivals'].url | default: collections['fw-27'].url | default: '/collections/all?sort_by=created-descending' -%}
{%- assign bestsellers = collections.bestsellers.url | default: '/collections/all?sort_by=best-selling' -%}
<ul class="okanosh-nav list-unstyled" role="list">
  <li><a href="{{ new_arrivals }}">New Arrivals</a></li>
  <li>
    <details>
      <summary>Shop {{ 'icon-caret.svg' | inline_asset_content }}</summary>
      <ul class="list-unstyled" role="list">
        <li><a href="{{ bestsellers }}">Bestsellers</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
        {%- assign categories = 'Sets,Tops,Shirts,Pants,Dresses' | split: ',' -%}
        {%- for title in categories -%}
          {%- assign handle = title | handleize -%}
          <li><a href="{{ collections[handle].url | default: routes.search_url }}{% if collections[handle] == blank %}?type=product&amp;q={{ title | url_encode }}{% endif %}">{{ title }}</a></li>
        {%- endfor -%}
      </ul>
    </details>
  </li>
  <li>
    <details>
      <summary>Collections {{ 'icon-caret.svg' | inline_asset_content }}</summary>
      <ul class="list-unstyled" role="list">
        {%- assign seasons = 'Summer Collection,Eid Collection' | split: ',' -%}
        {%- for title in seasons -%}
          {%- assign handle = title | handleize -%}
          <li><a href="{{ collections[handle].url | default: routes.collections_url }}">{{ title }}</a></li>
        {%- endfor -%}
      </ul>
    </details>
  </li>
  <li><a href="{{ pages['about-us'].url | default: '/pages/about-us' }}">About Us</a></li>
  <li><a class="okanosh-nav__sale" href="{{ collections.sale.url | default: '/search?type=product&amp;q=sale' }}">Sale</a></li>
</ul>
