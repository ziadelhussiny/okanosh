{%- liquid
  assign button_label = 'Save ' | append: product.title
  if context == 'product'
    assign button_label = 'Save to wishlist'
  endif
-%}

<ziad-wishlist-button
  class="zt-wishlist-button zt-wishlist-button--{{ context | default: 'card' }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url | escape }}"
  data-product-price="{{ product.price | money_with_currency | escape }}"
  data-product-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 }}{% endif %}"
  {% if block %}{{ block.shopify_attributes }}{% endif %}
>
  <button type="button" aria-pressed="false" aria-label="{{ button_label | escape }}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S4 16 4 9.8A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8 3.6c0 6.2-8 10.7-8 10.7Z"/></svg>
    {%- if context == 'product' -%}<span data-ziad-wishlist-label>Save to wishlist</span>{%- endif -%}
  </button>
</ziad-wishlist-button>
